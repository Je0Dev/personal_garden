---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageBanner from '../components/PageBanner.astro';
import GitHubCalendarComponent from '../components/GitHubCalendar';
import { getCollection, render } from 'astro:content';

const allPosts = await getCollection('blog');
const totalArticles = allPosts.length;

const languages = ['German', 'Spanish', 'Chinese', 'English'];
const languageCount = languages.length;

const aboutEntry = (await getCollection('pages')).find(e => e.id === 'about-page');
const { Content } = aboutEntry ? await render(aboutEntry) : { Content: null };
---

<BaseLayout title="About — George's Garden">
  <div class="pt-20 pb-12">
    <div class="max-w-wide mx-auto">
        <PageBanner image={`${import.meta.env.BASE_URL}images/alpaca-wolf.jpg`} height="h-64 md:h-[28rem]">
        <h1 class="text-4xl md:text-6xl lg:text-7xl font-black tracking-tight text-cream leading-[1.1] md:leading-none font-serif">
          <span class="relative inline-block">
            About <span class="absolute -bottom-1 left-0 w-full h-[2px] bg-tomato"></span>
          </span>
          <br />
        </h1>
      </PageBanner>

      <div class="px-6">
        <div class="space-y-16">
          <section class="space-y-6 text-lg md:text-xl text-earth-tan leading-relaxed max-w-4xl mx-auto text-center markdown-body">
            {Content && <Content />}
          </section>

          <section class="max-w-4xl mx-auto">
            <div class="grid gap-4 md:grid-cols-2">
              <div class="border border-moss  p-6 hover:border-olive-light transition-colors text-center">
                <div class="font-serif text-3xl font-bold text-tomato mb-2">{totalArticles}</div>
                <p class="font-sans text-earth-tan text-sm font-bold">Articles</p>
              </div>
              <div class="border border-moss  p-6 hover:border-olive-light transition-colors text-center">
                <div class="font-serif text-3xl font-bold text-olive-light mb-2">{languageCount}</div>
                <p class="font-sans text-earth-tan text-sm font-bold">Languages Absorbed</p>
              </div>
            </div>
          </section>

          <section class="max-w-4xl mx-auto pt-16 border-t border-moss">
            <h2 class="text-[10px] font-black uppercase tracking-[0.4em] text-earth-muted mb-6 font-serif text-center heading-underline">GitHub Activity</h2>
            <GitHubCalendarComponent client:idle />
          </section>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
