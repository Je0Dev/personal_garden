---
interface Props {
  downloads?: {
    name: string;
    file: string;
    description: string;
  }[];
  locale?: string;
}

const { downloads, locale = 'en' } = Astro.props;
import { getLangFromUrl, useTranslations } from '../i18n/utils';
const lang = locale;
const t = useTranslations(lang);
---

{downloads && downloads.length > 0 && (
  <div class="mt-10 max-w-prose">
    <h3 class="font-serif text-xl font-bold text-cream mb-4">
      <span class="relative inline-block after:absolute after:bottom-0 after:left-0 after:w-full after:h-[2px] after:bg-olive-light">
        {t('blog.downloads')}
      </span>
    </h3>
    <div class="space-y-3">
      {downloads.map((item, index) => (
        <a
          href={`${import.meta.env.BASE_URL}files/${item.file}`}
          download
          class="link-card flex items-start gap-3"
        >
          <svg class="w-4 h-4 text-tomato mt-1 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
            <polyline points="7 10 12 15 17 10"></polyline>
            <line x1="12" y1="15" x2="12" y2="3"></line>
          </svg>
          <div>
            <p class="link-card-title">{item.name}</p>
            <p class="link-card-desc">{item.description}</p>
          </div>
        </a>
      ))}
    </div>
  </div>
)}