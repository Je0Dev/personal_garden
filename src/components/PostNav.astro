---
interface Props {
  relatedPosts?: {
    id: string;
    title: string;
    slug: string;
  }[];
  prevPost?: { id: string; title: string; slug: string } | null;
  nextPost?: { id: string; title: string; slug: string } | null;
  downloads?: {
    name: string;
    file: string;
    description: string;
  }[];
  locale?: string;
}

const { relatedPosts, prevPost, nextPost, downloads, locale = 'en' } = Astro.props;
import { getLangFromUrl, useTranslations } from '../i18n/utils';
const lang = locale;
const t = useTranslations(lang);
---

<!-- Related Posts: Displays a grid of related blog post links -->

{relatedPosts && relatedPosts.length > 0 && (
  <div class="mt-16 border-t border-moss pt-8 max-w-wide mx-auto px-6">
    <h3 class="font-serif text-2xl font-bold text-cream mb-6">
      <span class="relative inline-block after:absolute after:bottom-0 after:left-0 after:w-full after:h-[2px] after:bg-olive-light">
        {t('blog.relatedReading')}
      </span>
    </h3>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {relatedPosts.map((related) => (
        <a
          href={`${import.meta.env.BASE_URL}${lang}/blog/${related.slug}/`}
          class="group p-4 bg-surface border border-moss hover:border-olive-light transition-colors"
        >
          <p class="font-serif text-cream group-hover:text-olive-light transition-colors mb-2">{related.title}</p>
        </a>
      ))}
    </div>
  </div>
)}

<!-- Previous/Next Navigation: Links to adjacent blog posts -->

<nav class="mt-16 border-t border-moss pt-8 max-w-wide mx-auto px-6">
  <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
    {prevPost ? (
      <a
        href={`${import.meta.env.BASE_URL}${lang}/blog/${prevPost.slug}/`}
        class="group flex items-start gap-4 p-4 bg-surface border border-moss hover:border-olive-light transition-colors"
      >
        <svg class="w-5 h-5 text-earth-muted group-hover:text-olive-light mt-1 flex-shrink-0 transition-colors" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="19" y1="12" x2="5" y2="12"></line>
          <polyline points="12 19 5 12 12 5"></polyline>
        </svg>
        <div>
          <p class="text-xs text-earth-muted font-sans mb-1">{t('blog.previous')}</p>
          <p class="font-serif text-cream group-hover:text-olive-light transition-colors">{prevPost.title}</p>
        </div>
      </a>
    ) : <div />}
    {nextPost ? (
      <a
        href={`${import.meta.env.BASE_URL}${lang}/blog/${nextPost.slug}/`}
        class="group flex items-start gap-4 p-4 bg-surface border border-moss hover:border-olive-light transition-colors text-right sm:text-left"
      >
        <div class="flex-1">
          <p class="text-xs text-earth-muted font-sans mb-1">{t('blog.next')}</p>
          <p class="font-serif text-cream group-hover:text-olive-light transition-colors">{nextPost.title}</p>
        </div>
        <svg class="w-5 h-5 text-earth-muted group-hover:text-olive-light mt-1 flex-shrink-0 transition-colors" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </a>
    ) : <div />}
  </div>
</nav>

<!-- Downloads: Lists downloadable file links for the current blog post -->

{downloads && downloads.length > 0 && (
  <div class="mt-10 max-w-prose">
    <h3 class="font-serif text-xl font-bold text-cream mb-4">
      <span class="relative inline-block after:absolute after:bottom-0 after:left-0 after:w-full after:h-[2px] after:bg-olive-light">
        {t('blog.downloads')}
      </span>
    </h3>
    <div class="space-y-3">
      {downloads.map((item, index) => (
        <a
          href={`${import.meta.env.BASE_URL}files/${item.file}`}
          download
          class="link-card flex items-start gap-3"
        >
          <svg class="w-4 h-4 text-tomato mt-1 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
            <polyline points="7 10 12 15 17 10"></polyline>
            <line x1="12" y1="15" x2="12" y2="3"></line>
          </svg>
          <div>
            <p class="link-card-title">{item.name}</p>
            <p class="link-card-desc">{item.description}</p>
          </div>
        </a>
      ))}
    </div>
  </div>
)}