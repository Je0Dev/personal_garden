---
interface Props {
  baseUrl: string;
}

const { baseUrl } = Astro.props;
---

<script is:inline>
  if ('serviceWorker' in navigator) {
    window.addEventListener('load', () => {
      navigator.serviceWorker.register(`${import.meta.env.BASE_URL}sw.js`).catch(() => {});
    });
  }
</script>

<script is:inline>
  (function () {
    var saved = localStorage.getItem('code-theme');
    var theme = saved || (document.documentElement.classList.contains('light') ? 'github-light' : 'vitesse-dark');
    document.documentElement.setAttribute('data-theme', theme);
  })();
</script>

<script is:inline>
  function enhanceCodeHeaders() {
    document.querySelectorAll('.expressive-code .frame').forEach((frame) => {
      if (frame.dataset.langEnhanced) return;
      const pre = frame.querySelector('pre[data-language]');
      const header = frame.querySelector('.header');
      if (!pre || !header) return;
      const lang = pre.getAttribute('data-language');
      if (lang) {
        const span = document.createElement('span');
        span.className = 'ec-lang-label';
        span.textContent = lang;
        header.appendChild(span);
      }
      frame.dataset.langEnhanced = 'true';
    });
  }
  enhanceCodeHeaders();
  document.addEventListener('astro:page-load', enhanceCodeHeaders);
</script>