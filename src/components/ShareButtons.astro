---
interface Props {
  title: string;
  url: string;
  locale?: string;
}

const { title, url, locale = 'en' } = Astro.props;
import { getLangFromUrl, useTranslations } from '../i18n/utils';
const lang = locale;
const t = useTranslations(lang);
const encodedUrl = encodeURIComponent(url);
const encodedTitle = encodeURIComponent(title);
const xShare = `https://twitter.com/intent/tweet?text=${encodedTitle}&url=${encodedUrl}`;
const linkedinShare = `https://www.linkedin.com/sharing/share-offsite/?url=${encodedUrl}`;
---

<div class="flex items-center gap-2">
  <span class="text-xs text-earth-muted font-sans mr-1">{t('blog.share')}</span>
  <a
    href={xShare}
    target="_blank"
    rel="noopener"
    aria-label={t('blog.shareOnX')}
    class="p-2 bg-surface border border-border hover:border-olive-light transition-colors text-earth-muted hover:text-olive-light"
  >
    <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
      <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24h-6.66l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"></path>
    </svg>
  </a>
  <a
    href={linkedinShare}
    target="_blank"
    rel="noopener"
    aria-label={t('blog.shareOnLinkedIn')}
    class="p-2 bg-surface border border-border hover:border-olive-light transition-colors text-earth-muted hover:text-olive-light"
  >
    <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
      <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"></path>
    </svg>
  </a>
  <button
    class="copy-link-btn p-2 bg-surface border border-border  hover:border-olive-light transition-colors"
    aria-label={t('blog.copyLink')}
    data-url={url}
    data-toast={t('toast.sharing')}
  >
    <svg class="w-4 h-4 text-earth-muted hover:text-olive-light copy-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path>
      <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path>
    </svg>
    <svg class="w-4 h-4 text-olive-light check-icon hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <polyline points="20 6 9 17 4 12"></polyline>
    </svg>
  </button>
</div>

<script>
  document.querySelectorAll('.copy-link-btn').forEach(btn => {
    btn.addEventListener('click', async () => {
      const url = (btn as HTMLElement).dataset.url;
      if (url) {
        try {
          await navigator.clipboard.writeText(url);
          const copyIcon = btn.querySelector('.copy-icon');
          const checkIcon = btn.querySelector('.check-icon');
          copyIcon?.classList.add('hidden');
          checkIcon?.classList.remove('hidden');
          const toastMsg = btn.getAttribute('data-toast') || 'Sharing is caring!';
          (window as any).addToast(toastMsg, 'success');
          setTimeout(() => {
            copyIcon?.classList.remove('hidden');
            checkIcon?.classList.add('hidden');
          }, 2000);
        } catch { /* ignore */ }
      }
    });
  });
</script>