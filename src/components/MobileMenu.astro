---
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const navItems = [
  { name: t('nav.home'), path: `${import.meta.env.BASE_URL}${lang}/` },
  { name: t('nav.blog'), path: `${import.meta.env.BASE_URL}${lang}/blog/` },
  { name: t('nav.about'), path: `${import.meta.env.BASE_URL}${lang}/about/` },
];
---

<div id="mobile-menu" class="fixed inset-0 z-[70] bg-deep-olive hidden">
  <div class="flex flex-col h-full">
    <div class="flex items-center justify-between px-6 py-4 border-b border-moss">
      <a 
        href={import.meta.env.BASE_URL}
        class="font-serif text-xl font-semibold text-cream"
      >
        George
      </a>
      <button
        id="close-mobile-menu"
        class="p-2 text-text-muted hover:text-cream transition-colors"
        aria-label={t('ui.closeMenu')}
      >
        <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>
    
    <nav class="flex-1 px-6 py-8">
      <ul class="space-y-6">
        {navItems.map(item => (
          <li>
            <a
              href={item.path}
              class="block text-3xl transition-colors text-cream hover:text-tomato"
            >
              {item.name}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    
    <div class="px-6 py-8 border-t border-moss">
      <p class="text-xs text-text-muted text-center">
        Cosmos — by George
      </p>
    </div>
  </div>
</div>

<script>
  const menu = document.getElementById('mobile-menu');
  const closeBtn = document.getElementById('close-mobile-menu');
  
  document.addEventListener('toggle-mobile-menu', () => {
    menu?.classList.toggle('hidden');
    document.body.style.overflow = menu?.classList.contains('hidden') ? '' : 'hidden';
  });

  closeBtn?.addEventListener('click', () => {
    menu?.classList.add('hidden');
    document.body.style.overflow = '';
  });
</script>