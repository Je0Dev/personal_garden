---
import CommandPalette from './CommandPalette';
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import LanguageSwitcher from './LanguageSwitcher.astro';
import HeaderScripts from './HeaderScripts.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const navLinks = [
  { href: `${import.meta.env.BASE_URL}${lang}/blog/`, label: t('nav.blog'), class: 'hidden sm:block' },
  { href: `${import.meta.env.BASE_URL}${lang}/about/`, label: t('nav.about'), class: 'hidden sm:block' },
];
const currentPath = Astro.url.pathname;
---

<!-- Site header with navigation, logo, search, theme toggle, and mobile menu button -->

<header id="main-header" class="fixed top-0 left-0 right-0 z-50 bg-bg/50 backdrop-blur-sm border-b border-border">
  <div class="max-w-wide mx-auto px-6 py-4 flex items-center justify-between">
    <a href={import.meta.env.BASE_URL} class="transition-colors hover:opacity-90">
      <img
        id="site-logo"
        src={`${import.meta.env.BASE_URL}home1.jpg`}
        alt="home"
        class="w-30 h-40 object-fill  transition-transform duration-300 mix-blend-screen"
      />
    </a>
    
    <nav class="flex items-center gap-4 sm:gap-6">
      {navLinks.map(link => (
        <a
          href={link.href}
          class={`text-sm transition-colors px-3 py-1.5 border border-moss hover:border-olive-light ${link.class} ${
            currentPath.includes(link.href) 
              ? 'text-cream border-olive-light' 
              : 'text-earth-tan hover:text-olive-light'
          }`}
        >
          {link.label}
        </a>
      ))}

      <a
        href={`${import.meta.env.BASE_URL}files/resume.pdf`}
        download="George_Mastrogiannis_Resume_En.pdf"
        class="hidden sm:inline-flex items-center gap-1.5 px-3 py-1.5 border border-moss text-earth-tan hover:border-olive-light hover:text-olive-light transition-colors text-sm"
        aria-label={t('home.downloadCv')}
      >
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
          <polyline points="7 10 12 15 17 10"></polyline>
          <line x1="12" y1="15" x2="12" y2="3"></line>
        </svg>
        {t('nav.cv')}
      </a>
      
      <button
        id="search-button"
        class="flex items-center gap-2 px-3 py-1.5 bg-deep-forest border border-moss hover:border-olive-light transition-colors text-sm text-earth-muted hover:text-olive-light"
        aria-label={t('nav.search')}
      >
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
        <span class="hidden sm:inline font-mono text-xs">⌘K</span>
      </button>
      
      <button
        id="mobile-menu-button"
        class="p-2 border border-moss text-earth-muted hover:border-olive-light hover:text-olive-light transition-colors sm:hidden flex items-center justify-center"
        aria-label={t('ui.openMenu')}
      >
        <svg class="w-1 h-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
      </button>
      <LanguageSwitcher class="hidden sm:flex" />
    </nav>
  </div>
</header>

<CommandPalette client:load baseUrl={import.meta.env.BASE_URL} locale={lang} />

<HeaderScripts baseUrl={import.meta.env.BASE_URL} />