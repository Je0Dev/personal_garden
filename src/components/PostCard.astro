---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { resolveImage } from '../lib/images';
import { renderInlineMarkdown } from '../lib/renderMarkdown';

interface Props {
  post: CollectionEntry<'blog'>;
  locale?: string;
}

const { post, locale = 'en' } = Astro.props;
const { title, description, date, tags, illustration } = post.data;
const resolvedImage = resolveImage(illustration);
const renderedDescription = renderInlineMarkdown(description);

const formattedDate = new Intl.DateTimeFormat(locale === 'zh' ? 'zh-CN' : locale === 'de' ? 'de-DE' : 'en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
}).format(date);
---

<a
  href={`${import.meta.env.BASE_URL}${locale}/blog/${post.id.split('/').slice(2).join('/')}/`}
  class="group block h-full bg-surface border border-border overflow-hidden hover:border-text-muted transition-colors duration-200"
>
  {resolvedImage && (
    <div class="aspect-[16/9] overflow-hidden">
      <Image
        src={resolvedImage}
        alt={title}
        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
        loading="lazy"
        widths={[400, 800]}
        sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 25vw"
      />
    </div>
  )}
  <div class="p-4">
    <div class="flex flex-wrap gap-1.5 mb-2">
      {tags.slice(0, 3).map(tag => (
        <span class="post-tag text-xs font-mono px-1.5 py-0.5 bg-moss/30 text-text-muted/70 hover:text-olive-light hover:bg-olive/20 cursor-pointer transition-colors" data-tag={tag}>
          #{tag}
        </span>
      ))}
    </div>
    <h3 class="font-bold text-cream group-hover:text-text-muted transition-colors mb-2 line-clamp-2 underline decoration-text-muted/30 underline-offset-2 group-hover:decoration-olive-light/50">
      {title}
    </h3>
    <div class="text-sm text-text-muted line-clamp-2 mb-3" set:html={renderedDescription} />
    <div class="flex items-center gap-3 text-xs text-text-muted">
      <span class="flex items-center gap-1">
        <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
          <line x1="16" y1="2" x2="16" y2="6"></line>
          <line x1="8" y1="2" x2="8" y2="6"></line>
          <line x1="3" y1="10" x2="21" y2="10"></line>
        </svg>
        {formattedDate}
      </span>
    </div>
  </div>
</a>

<script>
  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    if (target.classList.contains('post-tag')) {
      e.preventDefault();
      e.stopPropagation();
      e.stopImmediatePropagation();
      const tag = target.dataset.tag || '';
      if (tag) {
        window.location.href = `${import.meta.env.BASE_URL}${locale}/blog/?tag=${encodeURIComponent(tag)}`;
      }
    }
  }, true);
</script>
