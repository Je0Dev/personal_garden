---
import BaseLayout from './BaseLayout.astro';
import PageBanner from '../components/PageBanner.astro';
import ShareButtons from '../components/ShareButtons.astro';
import ArticleNav from '../components/ArticleNav.astro';
import PostDownloads from '../components/PostDownloads.astro';
import TableOfContents from '../components/TableOfContents.astro';
import RelatedPosts from '../components/RelatedPosts.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'blog'>;
  headings: { depth: number; slug: string; text: string }[];
  prevPost?: { id: string; title: string; slug: string } | null;
  nextPost?: { id: string; title: string; slug: string } | null;
}

const { post, headings, prevPost, nextPost } = Astro.props;
const { title, description, date, tags, illustration, author, relatedPosts, downloads } = post.data;

const formattedDate = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
}).format(date);
---

<BaseLayout title={title} description={description} image={illustration}>
  <article class="pt-20 pb-16">
    <PageBanner image={illustration} height="h-64 md:h-[28rem]">
      <h1 class="text-4xl md:text-6xl font-black tracking-tight text-cream leading-tight font-serif heading-underline">
        {title}
      </h1>
    </PageBanner>

    <header class="max-w-prose mx-auto px-6 mb-12">
      <nav class="flex items-center gap-2 text-sm text-text-muted mb-6 border border-moss rounded px-3 py-1.5 w-fit">
        <a href={import.meta.env.BASE_URL} class="text-olive-light underline underline-offset-2 decoration-olive-light/50 hover:text-tomato hover:decoration-tomato transition-colors">Home</a>
        <span class="text-earth-muted/40">/</span>
        <a href={`${import.meta.env.BASE_URL}tags/`} class="text-olive-light underline underline-offset-2 decoration-olive-light/50 hover:text-tomato hover:decoration-tomato transition-colors">Posts</a>
        <span class="text-earth-muted/40">/</span>
        <span class="text-earth-tan truncate max-w-[200px]">{title}</span>
      </nav>

      <div class="flex flex-wrap gap-2 mb-6">
        {tags.map((tag) => (
          <a href={`${import.meta.env.BASE_URL}tags/${encodeURIComponent(tag)}/`} class="tag-pill">#{tag}</a>
        ))}
      </div>

      <div class="flex flex-wrap items-center justify-between gap-4">
        <div class="flex flex-wrap items-center gap-4 text-sm text-text-muted mb-6">
          <span class="flex items-center gap-1.5 underline decoration-earth-muted/30 underline-offset-2">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
              <line x1="16" y1="2" x2="16" y2="6"></line>
              <line x1="8" y1="2" x2="8" y2="6"></line>
              <line x1="3" y1="10" x2="21" y2="10"></line>
            </svg>
            {formattedDate}
          </span>
        </div>
        <ShareButtons title={title} url={Astro.url.href} />
      </div>
    </header>

    <div class="max-w-wide mx-auto px-6">
      <div class="grid grid-cols-1 lg:grid-cols-4 gap-12">
        <TableOfContents headings={headings} />

        <div class="lg:col-span-3">
          <div class="prose max-w-prose markdown-body">
            <slot />
          </div>

          <PostDownloads downloads={downloads} />
        </div>
      </div>
    </div>

    <RelatedPosts relatedPosts={relatedPosts} />

    <ArticleNav prevPost={prevPost} nextPost={nextPost} />
  </article>
</BaseLayout>

<script>
  import '../scripts/blog-post.js';
</script>